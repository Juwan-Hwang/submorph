 "proxy-groups": [
  {
   "name": "节点选择",
   "type": "select",
   "proxies": [
    "自动选择",
    "故障转移",
    "负载均衡",
    "香港",
    "DIRECT"
   ]
  },
  {
   "name": "自动选择",
   "type": "url-test",
   "proxies": [
    "SS-2022 HK",
    "VMess WS TLS",
    "VLESS Reality Vision",
    "Hysteria2 hop"
   ],
   "url": "https://www.gstatic.com/generate_204",
   "interval": 300,
   "tolerance": 50
  },
  {
   "name": "故障转移",
   "type": "fallback",
   "proxies": [
    "VLESS Reality Vision",
    "TUIC v5",
    "AnyTLS"
   ],
   "url": "https://www.gstatic.com/generate_204",
   "interval": 300
  },
  {
   "name": "负载均衡",
   "type": "load-balance",
   "strategy": "consistent-hashing",
   "proxies": [
    "Trojan gRPC",
    "VMess gRPC"
   ],
   "url": "https://www.gstatic.com/generate_204",
   "interval": 300
  },
  {
   "name": "香港",
   "type": "select",
   "filter": "(?i)HK|香港",
   "include-all": true
  },
  {
   "name": "漏网之鱼",
   "type": "select",
   "proxies": [
    "节点选择",
    "DIRECT"
   ]
  }
 ],
 "rule-providers": {
  "ads": {
   "type": "http",
   "behavior": "domain",
   "format": "mrs",
   "url": "https://example.com/rules/ads.mrs",
   "path": "./ruleset/ads.mrs",
   "interval": 86400
  },
  "telegram-ip": {
   "type": "http",
   "behavior": "ipcidr",
   "format": "yaml",
   "url": "https://example.com/rules/telegram.yaml",
   "path": "./ruleset/telegram.yaml",
   "interval": 86400
  }
 },
 "rules": [
  "RULE-SET,ads,REJECT",
  "DOMAIN,api.example.com,DIRECT",
  "DOMAIN-SUFFIX,google.com,节点选择",
  "DOMAIN-KEYWORD,YouTube,节点选择",
  "DOMAIN-REGEX,^ads\\d+\\.example\\.net$,REJECT",
  "GEOSITE,openai,自动选择",
  "PROCESS-NAME,Telegram.exe,节点选择",
  "DST-PORT,22,DIRECT",
  "AND,((DOMAIN-SUFFIX,example.org),(NETWORK,UDP)),REJECT",
  "RULE-SET,telegram-ip,节点选择,no-resolve",
  "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve",
  "IP-CIDR6,fd00::/8,DIRECT,no-resolve",
  "GEOIP,LAN,DIRECT,no-resolve",
  "GEOSITE,cn,DIRECT",
  "GEOIP,CN,DIRECT",
  "MATCH,漏网之鱼"
 ]
}